# Backend Environment Variables
# 1. Copy this file: cp .env.example .env
# 2. Fill in local-only values below; never commit the resulting .env file.

PORT=3001
# URL encoded into the review QR. Use the Mac's LAN IP or an HTTPS tunnel for physical reviewer phones.
PUBLIC_BASE_URL=http://localhost:3001
JWT_SECRET=replace_with_a_long_random_local_secret
DEMO_CREATOR_PIN=replace_with_local_creator_pin
DEMO_ADMIN_PIN=replace_with_local_admin_pin

# Required: choose exactly "mock" or "elevenlabs".
TRANSCRIPTION_MODE=mock
# Required in mock mode. Empty is allowed and deterministically fails audio verification.
MOCK_TRANSCRIPT=
# Required only when TRANSCRIPTION_MODE=elevenlabs. The original MP4 is uploaded directly.
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY_HERE

# Required for RELEVANCE Deliverables. The verifier is locked to the stable gemini-2.5-flash model.
# Create a key in Google AI Studio and keep the real value only in backend/.env.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

USE_IN_MEMORY_DB=true
UPLOADS_DIR=uploads
# Optional Uniqlo demo fixtures: drop 2–4 manually pre-approved MP4s here.
DEMO_VIDEOS_DIR=demo-videos
